  "moves": [
    {
      "from": "Recorders & Media",
      "match": "reader|dock|station",
      "to": "media",
      "subcat": "Card Readers"
    },
    {
      "from": "Recorders & Media",
      "match": "macbook|ipad|vostro|laptop",
      "to": "media",
      "subcat": "Computers"
    },
    {
      "from": "Recorders & Media",
      "match": "^(?!.*(recorder|monitor)).*(mini-?mag|redmag|prossd|compact drive|memory card|\\bcard\\b|axs-a?\\d|\\d+\\s?gb)",
      "to": "media",
      "subcat": "Memory Cards"
    },
    {
      "from": "Recorders & Media",
      "match": "\\bssd\\b|external",
      "to": "media",
      "subcat": "Drives & SSD"
    }
  ]
